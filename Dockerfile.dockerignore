# Used instead of .dockerignore when building the root Dockerfile. Every
# workspace must be kept, or `yarn install --immutable` sees a stale lockfile.
.circleci
.vscode
.git
.nx
.claude
.DS_Store
.github
**/coverage
**/node_modules
.venv
**/.nyc_output
**/fxa-content-server-l10n
**/dist
packages/*/build
packages/*/public/locales
packages/fxa-auth-server/.mail_output
artifacts
tmp

# Local secrets and generated keys never belong in an image.
**/.env*
**/*.env
**/secrets.json
**/secret*
**/*.gpg
**/.keys
**/*-key.json
packages/fxa-auth-server/config/key.json
packages/fxa-auth-server/config/vapid-keys.json
_dev/firebase/.config

# Ignore generated credentials from google-github-actions/auth
gha-creds-*.json
