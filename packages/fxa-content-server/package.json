{
  "name": "fxa-content-server",
  "version": "0.0.0",
  "description": "Firefox Accounts Content Server",
  "scripts": {
    "prebuild": "yarn l10n-prime && yarn copy-local-config && yarn check-local-config ",
    "build": "yarn build-l10n && yarn build-css && yarn build-js",
    "build-fast": "yarn build-l10n && yarn build-css",
    "build-css": "NODE_ENV=production tailwindcss --postcss -i ./app/styles/tailwind.css -o ./app/styles/tailwind.out.css",
    "build-js": "NODE_ENV=production grunt build",
    "build-l10n": "yarn l10n-create-json",
    "check-local-config": "node scripts/check-local-config",
    "clean": "rimraf dist",
    "compile": "tsc --noEmit",
    "copy-local-config": "cp server/config/local.json-dist server/config/local.json",
    "glean-generate": "npx glean translate ../../libs/shared/metrics/glean/src/registry/fxa-backend-pings.yaml ../../libs/shared/metrics/glean/src/registry/fxa-backend-metrics.yaml -f javascript_server -s module_spec=commonjs -o server/lib/glean && prettier --config ../../_dev/.prettierrc --write server/lib/glean/*.js",
    "l10n-create-json": "NODE_OPTIONS=--openssl-legacy-provider grunt l10n-create-json",
    "l10n-prime": "yarn l10n:prime packages/fxa-content-server",
    "lint": "yarn lint-glean && eslint server --cache",
    "lint-glean": "npx glean glinter ../../libs/shared/metrics/glean/src/registry/fxa-ui-pings.yaml ../../libs/shared/metrics/glean/src/registry/fxa-ui-metrics.yaml",
    "start": "pm2 start pm2.config.js && yarn check:url localhost:3030/__lbheartbeat__ 200 fxa-content-server",
    "stop": "pm2 stop pm2.config.js",
    "restart": "pm2 restart pm2.config.js ",
    "delete": "pm2 delete pm2.config.js",
    "start-production": "NODE_ENV=production grunt build && yarn build-css && CONFIG_FILES=server/config/local.json,server/config/production.json,server/config/secrets.json grunt serverproc:dist",
    "start-remote": "scripts/run_remote_dev.sh",
    "test-unit": "MOCHA_FILE=../../artifacts/tests/$npm_package_name/fxa-content-server-mocha-unit-results.xml NODE_ENV=test mocha 'server/lib/**/*.test.js'",
    "format": "prettier --write --config ../../_dev/.prettierrc '**'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mozilla/fxa.git"
  },
  "homepage": "https://github.com/mozilla/fxa/tree/main/packages/fxa-content-server",
  "bugs": "https://github.com/mozilla/fxa/issues",
  "author": "Mozilla (https://mozilla.org/)",
  "license": "MPL-2.0",
  "dependencies": {
    "body-parser": "^1.20.9",
    "consolidate": "1.0.3",
    "convict": "^6.2.5",
    "convict-format-with-moment": "^6.2.0",
    "convict-format-with-validator": "^6.2.0",
    "cookie-parser": "1.4.6",
    "express": "^4.21.2",
    "fxa-auth-client": "workspace:*",
    "fxa-auth-server": "workspace:*",
    "fxa-geodb": "workspace:*",
    "fxa-profile-server": "workspace:*",
    "fxa-react": "workspace:*",
    "fxa-settings": "workspace:*",
    "grunt": "^1.6.1",
    "grunt-cdn": "0.6.5",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-concat": "2.1.0",
    "grunt-contrib-copy": "1.0.0",
    "grunt-contrib-cssmin": "5.0.0",
    "grunt-contrib-htmlmin": "3.1.0",
    "grunt-file-rev": "1.0.2",
    "grunt-po2json": "https://github.com/mozilla-fxa/grunt-po2json.git#2f415c8ac0435bf8942dc7131c3916ecd1684a46",
    "grunt-sri": "0.2.0",
    "grunt-text-replace": "0.4.0",
    "grunt-usemin": "3.1.1",
    "grunt-z-schema": "0.1.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.0.0",
    "hot-shots": "^10.2.1",
    "http-proxy-middleware": "^2.0.10",
    "i18n-abide": "0.0.26",
    "joi": "^17.13.8",
    "jsxgettext-recursive-next": "1.1.0",
    "load-grunt-tasks": "^5.1.0",
    "mocha": "^10.4.0",
    "morgan": "^1.11.0",
    "mozlog": "^3.0.2",
    "on-headers": "1.1.0",
    "serve-static": "^1.16.0",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^13.0.2",
    "verror": "1.10.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.5",
    "chai": "^5.3.3",
    "eslint": "^7.32.0",
    "grunt-ban-word": "0.1.1",
    "grunt-copyright": "0.3.0",
    "grunt-htmllint": "0.3.0",
    "grunt-jsonlint": "3.0.0",
    "grunt-newer": "1.3.0",
    "grunt-todo": "0.5.0",
    "pm2": "^7.0.0",
    "postcss-assets": "^6.0.0",
    "postcss-import": "^16.1.0",
    "prettier": "^3.5.3",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "5.5.3"
  },
  "readmeFilename": "README.md",
  "mocha": {
    "reporter": "mocha-multi",
    "reporterOptions": "spec=-,mocha-junit-reporter=-"
  },
  "nx": {
    "implicitDependencies": [
      "crypto-relier"
    ],
    "tags": [
      "scope:frontend",
      "type:core"
    ]
  }
}
