# AccountSwitcher component

# Accessible label for a list of accounts the user can sign in as.
account-switcher-group-label = Choose an account
# Shown for the account this browser itself is signed in as. Used both under an
# account in the switcher list and beside the current account in the account
# menu. Note this reflects being signed in to the browser, which is not the same
# as having Sync turned on.
account-switcher-signed-into-firefox = Signed in to { -brand-firefox }
# Shown under an account that has no active session, so choosing it means
# entering a password or other credentials again.
account-switcher-signed-out = Signed out
# Starts a sign-in for an account that is not stored on this device.
account-switcher-use-another-account = Use another account
# Label above the accounts stored on this device other than the one currently in
# use, shown in the Mozilla account menu.
account-switcher-other-accounts-label = Other accounts
