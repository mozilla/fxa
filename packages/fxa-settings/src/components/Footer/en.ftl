## Footer

# Accessible name of the navigation landmark that holds the footer links
footer-nav-label = Footer
# Link to the Mozilla accounts help site
footer-help-link = Help
# Hidden text on the button that opens the language and theme settings. A screen reader says it before the name of the current language.
footer-preferences-button = Language and theme
# Hidden text on the settings button when it only opens the language setting. A screen reader says it before the name of the current language.
footer-preferences-button-language = Language
# Hidden text on the settings button when it only opens the theme setting. A screen reader says it before the name of the current theme.
footer-preferences-button-theme = Theme
# Label for the group of theme choices: System, Light, Dark
footer-theme-legend = Theme
