## PasskeyCreationPromo
## Shared by the passkey promos shown right after signing in or signing up. Creating the passkey
## takes an email code, then one passkey prompt. Accounts with a password then get an optional
## second prompt that lets the passkey unlock synced data.

passkey-creation-promo-heading = Sign in faster with a passkey
passkey-creation-promo-create-button = Create passkey
passkey-creation-promo-maybe-later-button = Maybe later
passkey-creation-promo-retry-button = Try again

# Shown between the two passkey prompts, once the passkey exists.
passkey-creation-promo-created = Passkey created
passkey-creation-promo-sync-heading = Use your passkey with sync too?
# "sync" is lowercase on purpose, per Firefox content guidelines.
passkey-creation-promo-sync-description = If you sync { -brand-firefox }, confirm your passkey once more so it can also unlock your synced data, like passwords and bookmarks.
passkey-creation-promo-confirm-button = Confirm passkey
passkey-creation-promo-skip-button = Skip

passkey-creation-promo-error-create = Passkey setup didn’t finish. Try again.
# The passkey exists, but the second prompt that sets it up for sync was dismissed or timed out.
passkey-creation-promo-error-confirm = Passkey confirmation didn’t finish
passkey-creation-promo-error-confirm-description = Use your new passkey again to finish setting it up for sync.
# The passkey exists and can sign in, but this authenticator can't unlock synced data.
passkey-creation-promo-no-prf-description = You can sign in with it, but it can’t unlock synced data on this device. You’ll still need your password to sync on a new device.
passkey-creation-promo-sync-success = Your passkey is set up for sync
passkey-creation-promo-error-wrap = Your passkey was created but couldn’t be set up for sync. You can still sign in with it.
