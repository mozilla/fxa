{
  "name": "fxa-admin-panel",
  "version": "0.0.0",
  "description": "FxA Admin Panel",
  "scripts": {
    "build": "exit 0",
    "build-fast": "exit 0",
    "build-ts-client": "tsc --build",
    "build-ts-server": "tsc -p server/tsconfig.json && tsc-alias",
    "build-css": "npx tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/tailwind.out.css --postcss",
    "build-react": "NODE_ENV=production PUBLIC_URL=/ webpack --config config/webpack.config.js",
    "build-storybook": "NODE_ENV=production yarn build-css && storybook build",
    "clean": "rimraf dist",
    "compile": "tsc --noEmit",
    "format": "prettier --write --config ../../_dev/.prettierrc '**'",
    "lint": "eslint .",
    "restart": "pm2 restart pm2.config.js",
    "start": "pm2 start pm2.config.js",
    "stop": "pm2 stop pm2.config.js",
    "storybook": "yarn build-css && storybook dev -p 6011 --no-version-updates",
    "delete": "pm2 delete pm2.config.js",
    "test": "yarn test-unit",
    "test-frontend": "JEST_JUNIT_OUTPUT_FILE=../../artifacts/tests/$npm_package_name/fxa-admin-panel-frontend-jest-unit-results.xml jest --coverage --verbose --ci --reporters=default --reporters=jest-junit -t '^(?!.*#integration)'",
    "test-server": "JEST_JUNIT_OUTPUT_FILE=../../artifacts/tests/$npm_package_name/fxa-admin-panel-server-jest-unit-results.xml jest --runInBand --coverage --verbose --config server/jest.config.js --forceExit --ci --reporters=default --reporters=jest-junit -t '^(?!.*#integration)'",
    "test-unit": "CI=true yarn test-frontend && CI=true yarn test-server",
    "start-react": "NODE_ENV=development webpack serve --config config/webpack.config.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "body-parser": "^1.20.6",
    "convict": "^6.2.5",
    "convict-format-with-moment": "^6.2.0",
    "convict-format-with-validator": "^6.2.0",
    "dateformat": "^4.6.3",
    "express": "^4.21.2",
    "express-http-proxy": "^2.0.0",
    "fxa-admin-server": "workspace:*",
    "fxa-react": "workspace:*",
    "helmet": "^8.0.0",
    "mozlog": "^3.0.2",
    "on-headers": "^1.1.0",
    "react-hook-form": "^7.54.0",
    "react-router": "7.18.0",
    "serve-static": "^1.16.0"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.3",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-webpack5": "^8.0.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@types/chance": "^1.1.2",
    "@types/convict": "^6.1.1",
    "@types/dateformat": "^3.0.1",
    "@types/express": "^4.17.12",
    "@types/on-headers": "^2.1.30",
    "@types/postcss-import": "^14",
    "@types/serve-static": "1.13.9",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^7.1.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.1.3",
    "babel-preset-react-app": "^10.0.1",
    "chance": "^1.1.8",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-react": "^7.32.2",
    "file-loader": "^6.2.0",
    "fxa-shared": "workspace:*",
    "html-webpack-plugin": "^5.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.0",
    "nx": "^23.0.2",
    "pm2": "^7.0.0",
    "postcss-import": "^16.1.0",
    "prettier": "^3.5.3",
    "react-refresh": "^0.16.0",
    "storybook": "^8.0.0",
    "style-loader": "^4.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "3.4.3",
    "tailwindcss-textshadow": "^2.1.3",
    "ts-jest": "^29.2.3",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "5.5.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.5"
  },
  "nx": {
    "tags": [
      "scope:frontend",
      "type:admin"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "build-css",
          "build-react",
          "build-ts-client",
          "build-ts-server"
        ]
      },
      "build-fast": {
        "dependsOn": [
          "^build"
        ]
      },
      "build-react": {
        "dependsOn": [
          "^build",
          "build-css"
        ]
      },
      "build-storybook": {
        "dependsOn": []
      },
      "build-ts-client": {
        "dependsOn": [
          "^build"
        ]
      },
      "build-ts-server": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
