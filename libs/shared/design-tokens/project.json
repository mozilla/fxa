{
  "name": "shared-design-tokens",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/design-tokens/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/generated"],
      "inputs": [
        "{projectRoot}/src/**/*.mjs",
        "{workspaceRoot}/node_modules/acorn-web-components/dist/generated/tokens.js"
      ],
      "cache": true,
      "options": {
        "cwd": "libs/shared/design-tokens",
        "command": "node src/generate.mjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/shared/design-tokens/**/*.mjs"]
      }
    }
  }
}
