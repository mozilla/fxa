## ConnectThisDevice - the mobile card shown during desktop-to-mobile pairing,
## asking the user to confirm connecting the phone or tablet they are holding to
## their account. It shows the account email plus the browser, estimated
## location, and IP address of the desktop device that started the pairing.

# Alt text for the Firefox brand lockup at the top of the card
pair-connect-device-firefox-logo-alt = { -brand-firefox }
# Alt text for the illustration of a desktop and a mobile device syncing
pair-connect-device-image-alt = A desktop browser window and a mobile phone, both syncing, with the { -brand-firefox } mascot alongside them
pair-connect-device-heading = Connect this device to your account?
# Confirms the pairing and connects this device to the account
pair-connect-device-connect-button = Connect
# Abandons the pairing without connecting this device
pair-connect-device-cancel-button = Cancel
